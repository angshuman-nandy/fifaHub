# Copy to .env, fill in real values, then run ./deploy.sh
# .env is gitignored — never commit real secrets.

# Hugging Face token with WRITE scope: https://huggingface.co/settings/tokens
HF_TOKEN=

# Anthropic API key — used server-side by /api/claude and /api/llm, never committed
ANTHROPIC_API_KEY=

# OpenAI API key — only needed if LLM_PROVIDER=openai, used server-side by /api/llm
OPENAI_API_KEY=

# Which provider /api/llm uses: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Optional model overrides (defaults shown). "fast" tier is used for cheap,
# low-stakes write-ups (e.g. the prediction analysis); default tier covers
# breakdown narratives and the live-results fallback search.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4.1
# OPENAI_FAST_MODEL=gpt-4.1-mini

# GitHub repo to create/push to, format: owner/name
GH_REPO=

# Hugging Face Space to create/push to, format: owner/name
HF_SPACE=

# Private HF dataset backing the shared LLM-output cache (survives Space restarts).
# Format: owner/name. Needs HF_TOKEN with write access. Blank = local file only.
CACHE_DATASET=
